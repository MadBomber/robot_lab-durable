# frozen_string_literal: true

source 'https://rubygems.org'

gemspec

gem 'htm',       path: '../../../htm'
gem 'robot_lab', path: '../robot_lab'

group :development, :test do
  gem 'debug_me'
  gem 'flay'
  gem 'flog'
  gem 'minitest', '~> 5.16'
  gem 'minitest-reporters'
  gem 'rake',     '~> 13.0'
  gem 'redis' # examples/01_day_trader.rb only
  gem 'reek'
  gem 'rubocop'
end

group :test do
  gem 'simplecov', require: false
end
